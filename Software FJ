from __future__ import annotations

import logging
import re
from abc import ABC, abstractmethod
from datetime import datetime
from typing import Any


# ==============================================================================
# 1. CONFIGURACIÓN DEL ARCHIVO DE LOGS (EVENTOS Y ERRORES)
# ==============================================================================

LOG_FILE_NAME = "software_fj_eventos.log"


def configurar_logger(nombre_archivo: str = LOG_FILE_NAME) -> logging.Logger:
    """
    Configura un logger en archivo para registrar eventos relevantes y errores
    sin depender de bases de datos.
    """
    logger = logging.getLogger("SoftwareFJLogger")
    logger.setLevel(logging.INFO)

    # Evita duplicar handlers si se reconfigura en la misma sesión
    if not logger.handlers:
        file_handler = logging.FileHandler(nombre_archivo, mode="a", encoding="utf-8")
        formatter = logging.Formatter(
            "%(asctime)s | %(levelname)-8s | %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S",
        )
        file_handler.setFormatter(formatter)
        logger.addHandler(file_handler)

    return logger


logger = configurar_logger()


# ==============================================================================
# 2. JERARQUÍA DE EXCEPCIONES PERSONALIZADAS
# ==============================================================================

class SoftwareFJError(Exception):
    """Excepción base del dominio para la empresa Software FJ."""


class DatoInvalidoError(SoftwareFJError):
    """Se lanza cuando un dato no cumple con las reglas de formato o dominio."""


class ParametroFaltanteError(SoftwareFJError):
    """Se lanza cuando falta un parámetro obligatorio para la operación."""


class OperacionNoPermitidaError(SoftwareFJError):
    """Se lanza cuando el estado actual del objeto impide ejecutar la acción."""


class ReservaInvalidaError(SoftwareFJError):
    """Se lanza ante intentos incorrectos de crear, confirmar o procesar reservas."""


class ServicioNoDisponibleError(SoftwareFJError):
    """Se lanza cuando se intenta usar un servicio inactivo o no disponible."""


class CalculoInconsistenteError(SoftwareFJError):
    """Se lanza cuando un cálculo financiero o de duración produce valores inválidos."""


# ==============================================================================
# 3. CLASE ABSTRACTA GENERAL DE ENTIDADES DEL SISTEMA
# ==============================================================================

class EntidadSistema(ABC):
    """
    Clase abstracta base que representa entidades generales dentro de Software FJ.
    Garantiza un identificador, marca de tiempo de creación y un resumen estándar.
    """

    def __init__(self, id_entidad: str) -> None:
        if not isinstance(id_entidad, str) or not id_entidad.strip():
            raise DatoInvalidoError("El identificador de la entidad no puede estar vacío.")
        self._id_entidad: str = id_entidad.strip().upper()
        self._fecha_creacion: datetime = datetime.now()

    @property
    def id_entidad(self) -> str:
        """Retorna el identificador único de la entidad."""
        return self._id_entidad

    @property
    def fecha_creacion(self) -> datetime:
        """Retorna la fecha y hora de creación de la entidad."""
        return self._fecha_creacion

    @abstractmethod
    def resumen(self) -> str:
        """Método abstracto que cada entidad concreta debe implementar."""


# ==============================================================================
# 4. CLASE CLIENTE (ENCAPSULACIÓN Y VALIDACIONES ROBUSTAS)
# ==============================================================================

class Cliente(EntidadSistema):
    """
    Representa un cliente de Software FJ con encapsulación de datos personales
    y validaciones estrictas mediante propiedades (@property y @setter).
    """

    _PATRON_EMAIL = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")

    def __init__(self, id_cliente: str, nombre: str, correo: str, telefono: str) -> None:
        super().__init__(id_cliente)
        # Se asignan mediante setters para validar desde la construcción
        self.nombre = nombre
        self.correo = correo
        self.telefono = telefono
        self._activo: bool = True

    @property
    def nombre(self) -> str:
        return self._nombre

    @nombre.setter
    def nombre(self, valor: str) -> None:
        if not isinstance(valor, str) or len(valor.strip()) < 3:
            raise DatoInvalidoError(
                "El nombre del cliente debe ser un texto de al menos 3 caracteres."
            )
        self._nombre = valor.strip()

    @property
    def correo(self) -> str:
        return self._correo

    @correo.setter
    def correo(self, valor: str) -> None:
        if not isinstance(valor, str) or not self._PATRON_EMAIL.match(valor.strip()):
            raise DatoInvalidoError(
                f"Correo electrónico inválido para el cliente: '{valor}'."
            )
        self._correo = valor.strip().lower()

    @property
    def telefono(self) -> str:
        return self._telefono

    @telefono.setter
    def telefono(self, valor: str) -> None:
        limpio = str(valor).strip() if valor is not None else ""
        digitos = re.sub(r"[\s\-\+()]", "", limpio)
        if not digitos.isdigit() or len(digitos) < 7:
            raise DatoInvalidoError(
                f"Teléfono inválido para el cliente: '{valor}' (mínimo 7 dígitos)."
            )
        self._telefono = limpio

    @property
    def activo(self) -> bool:
        return self._activo

    def desactivar(self) -> None:
        self._activo = False

    def activar(self) -> None:
        self._activo = True

    def resumen(self) -> str:
        estado = "Activo" if self._activo else "Inactivo"
        return (
            f"Cliente [{self._id_entidad}] - {self._nombre} | "
            f"Correo: {self._correo} | Tel: {self._telefono} | Estado: {estado}"
        )


# ==============================================================================
# 5. CLASE ABSTRACTA SERVICIO Y SERVICIOS ESPECIALIZADOS (POLIMORFISMO + SOBRECARGA)
# ==============================================================================

class Servicio(EntidadSistema, ABC):
    """
    Clase abstracta que define el contrato común para los servicios de Software FJ.
    Incluye métodos abstractos para validar, describir y calcular costos,
    además de sobrecarga del cálculo de costos con impuestos, descuentos o extras.
    """

    def __init__(
        self,
        codigo_servicio: str,
        nombre_servicio: str,
        tarifa_base: float,
        disponible: bool = True,
    ) -> None:
        super().__init__(codigo_servicio)
        if not isinstance(nombre_servicio, str) or not nombre_servicio.strip():
            raise ParametroFaltanteError("El nombre del servicio es obligatorio.")
        if not isinstance(tarifa_base, (int, float)) or isinstance(tarifa_base, bool) or tarifa_base <= 0:
            raise DatoInvalidoError("La tarifa base del servicio debe ser un número mayor que 0.")

        self._nombre_servicio: str = nombre_servicio.strip()
        self._tarifa_base: float = float(tarifa_base)
        self._disponible: bool = bool(disponible)

    @property
    def nombre_servicio(self) -> str:
        return self._nombre_servicio

    @property
    def tarifa_base(self) -> float:
        return self._tarifa_base

    @property
    def disponible(self) -> bool:
        return self._disponible

    @disponible.setter
    def disponible(self, estado: bool) -> None:
        if not isinstance(estado, bool):
            raise DatoInvalidoError("La disponibilidad del servicio debe ser booleana.")
        self._disponible = estado

    def verificar_disponibilidad(self) -> None:
        """Verifica que el servicio esté habilitado antes de usarse."""
        if not self._disponible:
            raise ServicioNoDisponibleError(
                f"El servicio '{self._nombre_servicio}' ({self._id_entidad}) no está disponible."
            )

    @abstractmethod
    def validar_parametros(self, duracion: float, **kwargs: Any) -> None:
        """Valida duración y parámetros específicos de cada tipo de servicio."""

    @abstractmethod
    def describir(self) -> str:
        """Retorna una descripción detallada y polimórfica del servicio."""

    @abstractmethod
    def _calcular_subtotal(self, duracion: float, **kwargs: Any) -> float:
        """Calcula el subtotal base según el tipo de servicio y la duración."""

    def calcular_costo(
        self,
        duracion: float,
        impuesto: float = 0.0,
        descuento: float = 0.0,
        **kwargs: Any,
    ) -> float:
        """
        Método sobrecargado (mediante parámetros opcionales y kwargs) para calcular
        el costo final de un servicio:
        - Variante 1: calcular_costo(duracion)
        - Variante 2: calcular_costo(duracion, impuesto=0.19)
        - Variante 3: calcular_costo(duracion, impuesto=0.19, descuento=0.10)
        - Variante 4: calcular_costo(duracion, ..., kwargs específicos del servicio)
        """
        self.validar_parametros(duracion, **kwargs)

        if not all(
            isinstance(x, (int, float)) and not isinstance(x, bool)
            for x in (impuesto, descuento)
        ):
            raise DatoInvalidoError("Impuesto y descuento deben ser valores numéricos.")

        if impuesto < 0 or impuesto > 1:
            raise CalculoInconsistenteError(
                f"Porcentaje de impuesto inconsistente ({impuesto}); debe estar entre 0 y 1."
            )
        if descuento < 0 or descuento >= 1:
            raise CalculoInconsistenteError(
                f"Porcentaje de descuento inconsistente ({descuento}); debe estar en [0, 1)."
            )

        try:
            subtotal = self._calcular_subtotal(duracion, **kwargs)
            monto_descuento = subtotal * float(descuento)
            base_imponible = subtotal - monto_descuento
            total = base_imponible * (1.0 + float(impuesto))
        except Exception as exc:
            raise CalculoInconsistenteError(
                "Error inesperado al calcular el costo final del servicio."
            ) from exc

        if total < 0 or subtotal < 0:
            raise CalculoInconsistenteError(
                f"Cálculo inconsistente: el total resultante ({total}) no puede ser negativo."
            )

        return round(total, 2)

    def resumen(self) -> str:
        return self.describir()


class ReservaSalaServicio(Servicio):
    """Servicio especializado para reserva de salas (por horas y capacidad)."""

    def __init__(
        self,
        codigo_servicio: str,
        nombre_servicio: str,
        tarifa_hora: float,
        capacidad_maxima: int,
        disponible: bool = True,
    ) -> None:
        super().__init__(codigo_servicio, nombre_servicio, tarifa_hora, disponible)
        if not isinstance(capacidad_maxima, int) or isinstance(capacidad_maxima, bool) or capacidad_maxima <= 0:
            raise DatoInvalidoError("La capacidad máxima de la sala debe ser un entero positivo.")
        self._capacidad_maxima = capacidad_maxima

    def validar_parametros(self, duracion: float, **kwargs: Any) -> None:
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or duracion <= 0:
            raise DatoInvalidoError("La duración en horas para reserva de sala debe ser mayor que 0.")
        asistentes = kwargs.get("asistentes")
        if asistentes is not None:
            if not isinstance(asistentes, int) or isinstance(asistentes, bool) or asistentes <= 0:
                raise DatoInvalidoError("El número de asistentes debe ser un entero positivo.")
            if asistentes > self._capacidad_maxima:
                raise ReservaInvalidaError(
                    f"La sala '{self._nombre_servicio}' soporta máximo {self._capacidad_maxima} "
                    f"personas; se solicitaron {asistentes}."
                )

    def _calcular_subtotal(self, duracion: float, **kwargs: Any) -> float:
        return self._tarifa_base * float(duracion)

    def describir(self) -> str:
        estado_disp = "Disponible" if self._disponible else "No disponible"
        return (
            f"[Reserva de Sala] {self._nombre_servicio} ({self._id_entidad}) | "
            f"Tarifa/h: ${self._tarifa_base:.2f} | Cap. máx: {self._capacidad_maxima} | {estado_disp}"
        )


class AlquilerEquipoServicio(Servicio):
    """Servicio especializado para alquiler de equipos tecnológicos (por días/horas y cantidad)."""

    def __init__(
        self,
        codigo_servicio: str,
        nombre_servicio: str,
        tarifa_unidad: float,
        stock_disponible: int,
        disponible: bool = True,
    ) -> None:
        super().__init__(codigo_servicio, nombre_servicio, tarifa_unidad, disponible)
        if not isinstance(stock_disponible, int) or isinstance(stock_disponible, bool) or stock_disponible <= 0:
            raise DatoInvalidoError("El stock de equipos debe ser un entero positivo.")
        self._stock_disponible = stock_disponible

    def validar_parametros(self, duracion: float, **kwargs: Any) -> None:
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or duracion <= 0:
            raise DatoInvalidoError("La duración del alquiler debe ser mayor que 0.")
        cantidad = kwargs.get("cantidad", 1)
        if not isinstance(cantidad, int) or isinstance(cantidad, bool) or cantidad <= 0:
            raise DatoInvalidoError("La cantidad de equipos a alquilar debe ser un entero positivo.")
        if cantidad > self._stock_disponible:
            raise ServicioNoDisponibleError(
                f"Stock insuficiente en '{self._nombre_servicio}': disponibles {self._stock_disponible}, "
                f"solicitados {cantidad}."
            )

    def _calcular_subtotal(self, duracion: float, **kwargs: Any) -> float:
        cantidad = kwargs.get("cantidad", 1)
        return self._tarifa_base * float(duracion) * int(cantidad)

    def describir(self) -> str:
        estado_disp = "Disponible" if self._disponible else "No disponible"
        return (
            f"[Alquiler de Equipos] {self._nombre_servicio} ({self._id_entidad}) | "
            f"Tarifa/unidad/tiempo: ${self._tarifa_base:.2f} | Stock: {self._stock_disponible} | {estado_disp}"
        )


class AsesoriaEspecializadaServicio(Servicio):
    """Servicio especializado para asesorías técnicas (por horas y nivel de complejidad)."""

    MULTIPLICADORES_NIVEL = {
        "basica": 1.0,
        "intermedia": 1.25,
        "avanzada": 1.6,
    }

    def __init__(
        self,
        codigo_servicio: str,
        nombre_servicio: str,
        tarifa_hora: float,
        especialidad: str,
        disponible: bool = True,
    ) -> None:
        super().__init__(codigo_servicio, nombre_servicio, tarifa_hora, disponible)
        if not isinstance(especialidad, str) or not especialidad.strip():
            raise ParametroFaltanteError("La especialidad de la asesoría es obligatoria.")
        self._especialidad = especialidad.strip()

    def validar_parametros(self, duracion: float, **kwargs: Any) -> None:
        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or duracion <= 0:
            raise DatoInvalidoError("La duración de la asesoría en horas debe ser mayor que 0.")
        nivel = kwargs.get("nivel", "basica")
        if not isinstance(nivel, str) or nivel.lower() not in self.MULTIPLICADORES_NIVEL:
            raise DatoInvalidoError(
                f"Nivel de asesoría no válido: '{nivel}'. "
                f"Opciones: {list(self.MULTIPLICADORES_NIVEL.keys())}."
            )

    def _calcular_subtotal(self, duracion: float, **kwargs: Any) -> float:
        nivel = str(kwargs.get("nivel", "basica")).lower()
        multiplicador = self.MULTIPLICADORES_NIVEL[nivel]
        return self._tarifa_base * float(duracion) * multiplicador

    def describir(self) -> str:
        estado_disp = "Disponible" if self._disponible else "No disponible"
        return (
            f"[Asesoría Especializada] {self._nombre_servicio} ({self._id_entidad}) | "
            f"Área: {self._especialidad} | Tarifa base/h: ${self._tarifa_base:.2f} | {estado_disp}"
        )


# ==============================================================================
# 6. CLASE RESERVA (INTEGRACIÓN, ESTADOS Y MANEJO DE EXCEPCIONES)
# ==============================================================================

class Reserva(EntidadSistema):
    """
    Integra un Cliente, un Servicio, la duración y el estado de la reserva.
    Gestiona confirmación, cancelación y procesamiento con manejo de excepciones.
    """

    ESTADOS_VALIDOS = ("PENDIENTE", "CONFIRMADA", "CANCELADA", "PROCESADA")

    def __init__(
        self,
        id_reserva: str,
        cliente: Cliente,
        servicio: Servicio,
        duracion: float,
        impuesto: float = 0.0,
        descuento: float = 0.0,
        **detalle_servicio: Any,
    ) -> None:
        super().__init__(id_reserva)

        if not isinstance(cliente, Cliente):
            raise ReservaInvalidaError("La reserva requiere una instancia válida de Cliente.")
        if not isinstance(servicio, Servicio):
            raise ReservaInvalidaError("La reserva requiere una instancia válida de Servicio.")
        if not cliente.activo:
            raise OperacionNoPermitidaError(
                f"El cliente '{cliente.nombre}' ({cliente.id_entidad}) está inactivo."
            )

        # Verifica disponibilidad y valida parámetros del servicio antes de crear la reserva
        servicio.verificar_disponibilidad()
        costo_calculado = servicio.calcular_costo(
            duracion,
            impuesto=impuesto,
            descuento=descuento,
            **detalle_servicio,
        )

        self._cliente: Cliente = cliente
        self._servicio: Servicio = servicio
        self._duracion: float = float(duracion)
        self._detalle_servicio: dict[str, Any] = detalle_servicio
        self._impuesto: float = float(impuesto)
        self._descuento: float = float(descuento)
        self._costo_total: float = costo_calculado
        self._estado: str = "PENDIENTE"

    @property
    def cliente(self) -> Cliente:
        return self._cliente

    @property
    def servicio(self) -> Servicio:
        return self._servicio

    @property
    def duracion(self) -> float:
        return self._duracion

    @property
    def costo_total(self) -> float:
        return self._costo_total

    @property
    def estado(self) -> str:
        return self._estado

    def confirmar(self) -> str:
        """Confirma una reserva pendiente."""
        if self._estado == "CANCELADA":
            raise OperacionNoPermitidaError(
                f"No se puede confirmar la reserva {self._id_entidad} porque fue cancelada."
            )
        if self._estado == "PROCESADA":
            raise OperacionNoPermitidaError(
                f"La reserva {self._id_entidad} ya fue procesada."
            )
        if self._estado == "CONFIRMADA":
            raise OperacionNoPermitidaError(
                f"La reserva {self._id_entidad} ya se encuentra confirmada."
            )

        self._estado = "CONFIRMADA"
        mensaje = f"Reserva {self._id_entidad} CONFIRMADA para {self._cliente.nombre}."
        logger.info(mensaje)
        return mensaje

    def cancelar(self, motivo: str = "Sin motivo especificado") -> str:
        """Cancela una reserva si no ha sido procesada."""
        if self._estado == "PROCESADA":
            raise OperacionNoPermitidaError(
                f"No se puede cancelar la reserva {self._id_entidad} porque ya fue procesada."
            )
        if self._estado == "CANCELADA":
            raise OperacionNoPermitidaError(
                f"La reserva {self._id_entidad} ya estaba cancelada."
            )

        self._estado = "CANCELADA"
        mensaje = (
            f"Reserva {self._id_entidad} CANCELADA para {self._cliente.nombre}. "
            f"Motivo: {motivo}"
        )
        logger.info(mensaje)
        return mensaje

    def procesar(self) -> str:
        """
        Procesa una reserva confirmada recalculando y validando el costo final.
        Demuestra encadenamiento de excepciones y bloques try/except/finally.
        """
        if self._estado != "CONFIRMADA":
            raise OperacionNoPermitidaError(
                f"Solo se pueden procesar reservas en estado CONFIRMADA. "
                f"Estado actual de {self._id_entidad}: {self._estado}."
            )

        try:
            self._servicio.verificar_disponibilidad()
            costo_verificado = self._servicio.calcular_costo(
                self._duracion,
                impuesto=self._impuesto,
                descuento=self._descuento,
                **self._detalle_servicio,
            )
            if abs(costo_verificado - self._costo_total) > 0.01:
                raise CalculoInconsistenteError(
                    f"Discrepancia en costo de {self._id_entidad}: "
                    f"inicial ${self._costo_total:.2f} vs verificado ${costo_verificado:.2f}."
                )
        except SoftwareFJError as exc:
            # Encadenamiento explícito de excepciones manteniendo la causa original
            raise ReservaInvalidaError(
                f"Fallo al procesar la reserva {self._id_entidad}."
            ) from exc
        finally:
            logger.info(
                f"Intento de procesamiento finalizado para reserva {self._id_entidad} "
                f"(estado actual: {self._estado})."
            )

        self._estado = "PROCESADA"
        mensaje = (
            f"Reserva {self._id_entidad} PROCESADA exitosamente | "
            f"Servicio: {self._servicio.nombre_servicio} | Total: ${self._costo_total:.2f}"
        )
        logger.info(mensaje)
        return mensaje

    def resumen(self) -> str:
        return (
            f"Reserva [{self._id_entidad}] | Estado: {self._estado} | "
            f"Cliente: {self._cliente.nombre} | Servicio: {self._servicio.nombre_servicio} | "
            f"Duración: {self._duracion} | Costo: ${self._costo_total:.2f}"
        )


# ==============================================================================
# 7. GESTOR CENTRAL EN MEMORIA (LISTAS + MANEJO DE EXCEPCIONES)
# ==============================================================================

class GestorSoftwareFJ:
    """
    Coordina clientes, servicios y reservas en listas en memoria, registrando
    cada evento o error en el archivo de logs sin interrumpir la ejecución.
    """

    def __init__(self) -> None:
        self.clientes: list[Cliente] = []
        self.servicios: list[Servicio] = []
        self.reservas: list[Reserva] = []

    def registrar_cliente(
        self, id_cliente: str, nombre: str, correo: str, telefono: str
    ) -> Cliente | None:
        try:
            cliente = Cliente(id_cliente, nombre, correo, telefono)
        except SoftwareFJError as exc:
            logger.error(f"Error al registrar cliente '{id_cliente}': {exc}")
            print(f"[ERROR - Cliente] {exc}")
            return None
        else:
            self.clientes.append(cliente)
            msg = f"Cliente registrado: {cliente.resumen()}"
            logger.info(msg)
            print(f"[OK] {msg}")
            return cliente
        finally:
            logger.info(f"Operación 'registrar_cliente' evaluada para ID '{id_cliente}'.")

    def registrar_servicio(self, servicio: Servicio | None) -> Servicio | None:
        try:
            if servicio is None or not isinstance(servicio, Servicio):
                raise ParametroFaltanteError("Se requiere una instancia válida de Servicio.")
        except SoftwareFJError as exc:
            logger.error(f"Error al registrar servicio: {exc}")
            print(f"[ERROR - Servicio] {exc}")
            return None
        else:
            self.servicios.append(servicio)
            msg = f"Servicio registrado: {servicio.describir()}"
            logger.info(msg)
            print(f"[OK] {msg}")
            return servicio

    def crear_reserva(
        self,
        id_reserva: str,
        cliente: Cliente | None,
        servicio: Servicio | None,
        duracion: float,
        impuesto: float = 0.0,
        descuento: float = 0.0,
        **detalle_servicio: Any,
    ) -> Reserva | None:
        try:
            if cliente is None or servicio is None:
                raise ParametroFaltanteError(
                    "Cliente y Servicio son obligatorios para crear una reserva."
                )
            reserva = Reserva(
                id_reserva=id_reserva,
                cliente=cliente,
                servicio=servicio,
                duracion=duracion,
                impuesto=impuesto,
                descuento=descuento,
                **detalle_servicio,
            )
        except SoftwareFJError as exc:
            logger.error(f"Error al crear reserva '{id_reserva}': {exc}")
            print(f"[ERROR - Reserva] {exc}")
            return None
        else:
            self.reservas.append(reserva)
            msg = f"Reserva creada: {reserva.resumen()}"
            logger.info(msg)
            print(f"[OK] {msg}")
            return reserva

    def ejecutar_ciclo_reserva(self, reserva: Reserva | None, confirmar: bool = True, procesar: bool = True) -> None:
        """Ejecuta confirmación y/o procesamiento con manejo seguro de excepciones."""
        if reserva is None:
            logger.warning("Se intentó operar sobre una reserva inexistente (None).")
            print("[AVISO] No se puede operar sobre una reserva nula.")
            return

        try:
            if confirmar:
                print(f"[OK] {reserva.confirmar()}")
            if procesar:
                print(f"[OK] {reserva.procesar()}")
        except SoftwareFJError as exc:
            causa_original = f" | Causa raíz: {exc.__cause__}" if exc.__cause__ else ""
            logger.error(f"Error en ciclo de reserva '{reserva.id_entidad}': {exc}{causa_original}")
            print(f"[ERROR - Ciclo Reserva] {exc}{causa_original}")


